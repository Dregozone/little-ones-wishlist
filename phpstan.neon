includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Concerns consumed only by Livewire single-file pages in resources/views/pages,
        # which PHPStan does not analyse, so it cannot see the `use` statement.
        -
            identifier: trait.unused
            path: app/Concerns/ProfileValidationRules.php
